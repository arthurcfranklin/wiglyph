/* --------------------------------------------------------------------------
   WiGlyph
   Dark desktop application theme
   -------------------------------------------------------------------------- */


/* Base
   -------------------------------------------------------------------------- */

QMainWindow,
QWidget#centralWidget {
    background-color: #0e1014;
    color: #f4f5f7;
}

QWidget {
    color: #f4f5f7;
    font-size: 14px;
}

QLabel {
    background: transparent;
}


/* Typography
   -------------------------------------------------------------------------- */

QLabel#title {
    color: #f4f5f7;
    font-size: 27px;
    font-weight: 700;
}

QLabel#subtitle {
    color: #8b94a1;
    font-size: 13px;
}

QLabel#sectionTitle {
    color: #8d96a3;
    font-size: 11px;
    font-weight: 600;
}

QLabel#fieldLabel {
    color: #c9ced6;
    font-size: 13px;
    font-weight: 500;
}


/* Header
   -------------------------------------------------------------------------- */

QFrame#appHeader {
    background: transparent;
    border-bottom: 1px solid #20242b;
}

QLabel#appIcon {
    background: transparent;
}

QLabel#privacyBadge {
    padding: 6px 11px;

    background-color: #15191f;
    color: #aeb6c1;

    border: 1px solid #2a3039;
    border-radius: 7px;

    font-size: 11px;
    font-weight: 600;
}

QLabel#headerVersion {
    color: #626b77;
    font-size: 10px;
}


/* Main modules
   -------------------------------------------------------------------------- */

QFrame#formModule,
QFrame#resultModule,
QFrame#historyModule,
QFrame#detailsModule,
QFrame#informationModule {
    background-color: #12151a;

    border: 1px solid #252a33;
    border-radius: 12px;
}

/*
   formModule and resultModule deliberately have no fixed height.
   The primary row absorbs all remaining workspace height, keeping
   the three left-side levels contiguous and aligned with history.
*/


/* Inputs
   -------------------------------------------------------------------------- */

QLineEdit,
QComboBox {
    min-height: 24px;
    padding: 9px 12px;

    background-color: #171a20;
    color: #f4f5f7;

    border: 1px solid #2b3039;
    border-radius: 8px;

    selection-background-color: #3c68b1;
    selection-color: #ffffff;
}

QLineEdit:hover,
QComboBox:hover {
    border-color: #3a414d;
}

QLineEdit:focus,
QComboBox:focus {
    border-color: #557fc4;
}

QLineEdit:disabled,
QComboBox:disabled {
    background-color: #14171c;
    color: #626a76;
    border-color: #23272f;
}


/* Combo box
   -------------------------------------------------------------------------- */

QComboBox {
    padding-right: 38px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;

    width: 36px;

    border: none;
}

QComboBox::down-arrow {
    image: url("{{CHEVRON_ICON}}");

    width: 16px;
    height: 16px;
}

QComboBox QAbstractItemView {
    padding: 4px;

    background-color: #171a20;
    color: #f4f5f7;

    border: 1px solid #303640;
    outline: none;

    selection-background-color: #252b34;
    selection-color: #ffffff;
}


/* Check box
   -------------------------------------------------------------------------- */

QCheckBox {
    spacing: 9px;

    background: transparent;
    color: #c9ced6;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;

    background-color: #171a20;

    border: 1px solid #414854;
    border-radius: 4px;
}

QCheckBox::indicator:hover {
    border-color: #596372;
}

QCheckBox::indicator:checked {
    image: url("{{CHECK_ICON}}");

    background-color: #557fc4;
    border-color: #557fc4;
}


/* Primary action
   -------------------------------------------------------------------------- */

QPushButton#primaryButton {
    min-height: 24px;
    padding: 10px 16px;

    background-color: #557fc4;
    color: #ffffff;

    border: none;
    border-radius: 8px;

    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #628bd0;
}

QPushButton#primaryButton:pressed {
    background-color: #496fad;
}

QPushButton#primaryButton:disabled {
    background-color: #252a32;
    color: #646c78;
}


/* Secondary actions
   -------------------------------------------------------------------------- */

QPushButton#secondaryButton {
    min-height: 22px;
    padding: 8px 14px;

    background-color: #181b21;
    color: #d9dde3;

    border: 1px solid #2c323c;
    border-radius: 7px;

    font-weight: 500;
}

QPushButton#secondaryButton:hover {
    background-color: #1e2229;
    border-color: #3b424e;
}

QPushButton#secondaryButton:pressed {
    background-color: #15181d;
}


/* QR preview
   -------------------------------------------------------------------------- */

QFrame#previewArea {
    background-color: #101318;

    border: 1px solid #20252d;
    border-radius: 9px;
}

QLabel#emptyStateIcon {
    color: #59616d;
    font-size: 30px;
}

QLabel#emptyStateTitle {
    color: #dfe2e7;
    font-size: 15px;
    font-weight: 600;
}

QLabel#emptyStateDescription {
    color: #777f8b;
    font-size: 12px;
}

QLabel#qrPreview {
    background-color: #ffffff;

    border: none;
    border-radius: 8px;
}

QLabel#readyStatus {
    color: #8d96a3;
    font-size: 12px;
}


/* Session history
   -------------------------------------------------------------------------- */

QLabel#historyCounter {
    padding: 3px 7px;

    background-color: #181c22;
    color: #737d8a;

    border: 1px solid #292f38;
    border-radius: 6px;

    font-size: 10px;
    font-weight: 600;
}

QLabel#historyDescription {
    color: #737c89;
    font-size: 11px;
}

QWidget#historyEntries {
    background: transparent;
}

QLabel#historyEmptyState {
    min-height: 210px;
    padding: 20px;

    background-color: #101318;
    color: #68717e;

    border: 1px dashed #292f38;
    border-radius: 9px;

    font-size: 11px;
}

QFrame#historyCard {
    min-height: 66px;
    max-height: 66px;

    background-color: #16191f;

    border: 1px solid #292e37;
    border-radius: 9px;
}

QFrame#historyCard:hover {
    background-color: #1a1e25;
    border-color: #39414d;
}

QLabel#historyPreview {
    background-color: #ffffff;

    border: none;
    border-radius: 6px;
}

QLabel#historyNetworkName {
    color: #e4e7eb;
    font-size: 12px;
    font-weight: 600;
}

QLabel#historyTimestamp {
    color: #707986;
    font-size: 10px;
}

QPushButton#historyClearButton {
    min-height: 20px;
    padding: 7px 10px;

    background: transparent;
    color: #7f8895;

    border: 1px solid #292f38;
    border-radius: 7px;

    font-size: 11px;
    font-weight: 500;
}

QPushButton#historyClearButton:hover {
    background-color: #181c22;
    color: #c3c8cf;
    border-color: #39414d;
}

QPushButton#historyClearButton:pressed {
    background-color: #14171c;
}


/* Access details
   -------------------------------------------------------------------------- */

QFrame#detailsModule {
    min-height: 104px;
    max-height: 104px;
}

QWidget#detailsContent {
    background: transparent;
}

QLabel#detailLabel {
    color: #737c89;
    font-size: 10px;
    font-weight: 600;
}

QLabel#detailValue {
    color: #eef0f3;
    font-size: 13px;
    font-weight: 500;
}


/* Information module
   -------------------------------------------------------------------------- */

QFrame#informationModule {
    min-height: 106px;
    max-height: 106px;
}

QLabel#infoPanelTitle {
    color: #8d96a3;
    font-size: 11px;
    font-weight: 600;
}

QLabel#infoPanelDescription {
    color: #c4c9d0;
    font-size: 13px;
}

QFrame#informationDivider {
    min-width: 1px;
    max-width: 1px;

    background-color: #292e38;
    border: none;
}


/* Status
   -------------------------------------------------------------------------- */

QLabel#status {
    color: #7fc69a;
    font-size: 12px;
}

QLabel#status[error="true"] {
    color: #e18484;
}


/* Footer
   -------------------------------------------------------------------------- */

QFrame#footer {
    min-height: 32px;

    background: transparent;

    border-top: 1px solid #20242b;
}

QLabel#footerCopyright,
QLabel#footerMeta {
    color: #626b77;
    font-size: 10px;
}

QLabel#footerCopyright {
    font-weight: 500;
}
